
Options -Indexes
DirectoryIndex index.php
RewriteEngine On

# Rutas administrativas
RewriteRule ^admin/?$ index.php [END]

RewriteRule ^admin/(login|salir|producto/guardar|producto/eliminar|producto/visibilidad|pedido/estado|resena/aprobar|inventario/movimiento|informes(?:/pdf)?)/?$ index.php [END]

# Redireccionar rutas antiguas
RewriteRule ^admin/(index|login)\.php$ /admin/login [R=302,END]

# Proteger carpetas y archivos internos
RewriteRule ^(data|views|app_admin|admin|\.git|\.vscode)(/|$) - [F,END,NC]
RewriteRule (^|/)\.(?!well-known/) - [F,END]
RewriteRule ^(Dockerfile|router\.php|README.*|MIGRACION.*|DESPLIEGUE.*|.*\.md)$ - [F,END,NC]

# Permitir archivos existentes
RewriteCond %{REQUEST_FILENAME} -f
RewriteRule ^ - [END]

# Enviar las demás rutas al controlador PHP
RewriteRule ^ index.php [END]
