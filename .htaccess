Options -Indexes
DirectoryIndex index.php
RewriteEngine On

# Bloquear acceso web a configuración, código auxiliar y respaldos.
<FilesMatch "^(?:security\.php|\.env(?:\..*)?|composer\.(?:json|lock)|.*\.(?:bak|backup|sql|log|ini|swp))$">
    Require all denied
</FilesMatch>

# Public admin routes go through the application controller.
RewriteRule ^admin/?$ index.php [END]
RewriteRule ^admin/(login|salir|producto/guardar|producto/eliminar|producto/visibilidad|pedido/estado|resena/aprobar|inventario/(?:movimiento|anular-entrada)|informes(?:/pdf)?|productos|producto/nuevo|pedidos|resenas|ventas|mercancia/(?:entrada|salida|comprobante/pdf)|movimientos)/?$ index.php [END]
RewriteRule ^admin/(index|login)\.php$ /admin/login [R=302,END]

# Never expose internal application source or data.
RewriteRule ^(data|views|app_admin|admin|vendor|\.git|\.vscode)(/|$) - [F,END,NC]
RewriteRule (^|/)\.(?!well-known/) - [F,END]
RewriteRule ^(Dockerfile|router\.php|README.*|MIGRACION.*|DESPLIEGUE.*|.*\.md)$ - [F,END,NC]

RewriteCond %{REQUEST_FILENAME} -f
RewriteRule ^ - [END]
RewriteRule ^ index.php [END]
